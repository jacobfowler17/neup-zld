# HTC Submit File

# Provide HTCondor with the name of the Docker container
container_image = docker://jfowler5/neup-zld:alpha-test
universe = container

executable = run.sh
arguments  = $(NUM_PARAMS) $(SPECIES)

transfer_input_files  = src/
transfer_output_files = neup_zld/results/sweep_$(SPECIES)_$(NUM_PARAMS)var/

log    = logs/sweep_$(SPECIES)_$(NUM_PARAMS)var.log
error  = errors/sweep_$(SPECIES)_$(NUM_PARAMS)var.err
output = outputs/sweep_$(SPECIES)_$(NUM_PARAMS)var.out

request_cpus   = 6
request_memory = 8GB
request_disk   = 8GB

queue NUM_PARAMS SPECIES from arguments.txt
