# HTC Submit File

# Provide HTCondor with the name of the Docker container
container_image = docker://jfowler5/neup-zld:alpha-test
universe = container

executable = run.sh
arguments  = $(MODE) $(INPUTS) $(VERBOSE)

transfer_input_files   = src/
transfer_output_files  = neup-zld/results/$(INPUTS)

log    = logs/$(INPUTS).log
error  = errors/$(INPUTS).err
output = outputs/$(INPUTS).out

request_cpus   = 10
request_memory = 40GB
request_disk   = 2.0GB

queue MODE INPUTS VERBOSE from arguments.txt
